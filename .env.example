# Copy this file to .env on the VM and fill in real values.
TRANSPORT=waha
WAHA_URL=http://waha:3000
WAHA_API_KEY=replace-with-a-long-random-api-key
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-long-random-password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace-with-a-long-random-password
WAHA_SESSION=default
SOURCE_CHAT_ID=120363123456789012@g.us
TARGET_CHAT_ID=120363987654321098@g.us
# Route-specific chat IDs; add a pair for each additional Compose route.
LUPYNIS_SOURCE_CHAT_ID=replace-with-source-group@g.us
LUPYNIS_TARGET_CHAT_ID=replace-with-target-group@g.us
# Optional; when set, health alerts go only to this recipient, not either route's TARGET_CHAT_ID.
# When unset, each route defaults to its own TARGET_CHAT_ID. For WAHA, use a recipient chat ID.
# ALERT_CHAT_ID=15551234567@c.us
# Dedicated courier-health container sends health alerts; forwarding routes do not monitor health.
LOG_LEVEL=INFO
LISTEN_PORT=8000
INCLUDE_FROM_ME=false
COURIER_TAG=latest
