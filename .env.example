# Copy this file to .env on the VM and fill in real values. Keep it private (chmod 600).
# .env configures WAHA. Courier containers are configured by their own YAML files
# (config.yaml, config-tfl.yaml, config-health.yaml); the only value they take from here is WAHA_API_KEY.

# WAHA API key; Courier uses the same key to call WAHA.
WAHA_API_KEY=replace-with-a-long-random-api-key
# WAHA dashboard and Swagger logins.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-long-random-password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace-with-a-long-random-password
# WAHA image and engine; default to NOWEB on ARM64.
WAHA_IMAGE=devlikeapro/waha:noweb-arm
WHATSAPP_DEFAULT_ENGINE=NOWEB

# Courier image tag for every Courier container: latest, an exact version such as 0.9.0, or a commit SHA.
COURIER_TAG=latest
