# Copy this file to .env on the VM and fill in real values.
TRANSPORT=waha
WAHA_URL=http://waha:3000
WAHA_API_KEY=replace-with-a-long-random-api-key
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-long-random-password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace-with-a-long-random-password
WAHA_SESSION=default
SOURCE_CHAT_ID=120363123456789012@g.us
TARGET_CHAT_ID=120363987654321098@g.us
LOG_LEVEL=INFO
LISTEN_PORT=8000
COURIER_TAG=latest
